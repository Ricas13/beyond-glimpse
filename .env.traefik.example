# Copy this file to .env and replace the placeholders.

# Traefik routing
BEYOND_GLIMPSE_HOST=glimpse.example.com
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Primary media server
PRIMARY_SERVER=jellyfin

# Jellyfin
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_TOKEN=replace-me
JELLYFIN_USER_ID=
JELLYFIN_EXCLUDE_LIBRARIES=

# On-demand Jellyfin posters. Posters are NOT bulk-downloaded during sync.
# Nginx keeps only actually-viewed posters in a hard-bounded 256 MiB cache.
POSTER_PROXY_MAX_WIDTH=320
POSTER_PROXY_QUALITY=72

# Optional Plex/Emby — leave empty when unused
PLEX_URL=
PLEX_TOKEN=
PLEX_EXCLUDE_LIBRARIES=
EMBY_URL=
EMBY_TOKEN=
EMBY_USER_ID=
EMBY_EXCLUDE_LIBRARIES=

# Large-library sync/artwork
# PAGE_SIZE is retained for incremental changed-metadata requests.
PAGE_SIZE=500
# Full rich metadata rebuilds start smaller because People/Overview/etc can be
# expensive on large Jellyfin libraries. Read timeouts automatically halve this.
FULL_SYNC_PAGE_SIZE=100
BACKDROP_MAX_WIDTH=1280
IMAGE_QUALITY=82
DOWNLOAD_BACKDROPS=false
REQUEST_TIMEOUT=60

# Jellyfin incremental sync. Normal runs request changed metadata only; every
# FULL_RECONCILE_HOURS an ID-only inventory catches deletions/moves cheaply.
INCREMENTAL_SYNC=true
FULL_RECONCILE_HOURS=24
SYNC_OVERLAP_SECONDS=300
FORCE_FULL_SYNC=false

# General
CRON_SCHEDULE="0 */6 * * *"
TZ=Europe/London
APP_TITLE=Beyond Glimpse
SORT_BY_DATE_ADDED=false
