# Copy this file to .env and replace the placeholders.

# Traefik routing
BEYOND_GLIMPSE_HOST=glimpse.example.com
TRAEFIK_NETWORK=media_net
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Primary media server
PRIMARY_SERVER=jellyfin

# Jellyfin
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_TOKEN=replace-me
# Strongly recommended on multi-user servers so catalogue visibility is deterministic.
JELLYFIN_USER_ID=
JELLYFIN_EXCLUDE_LIBRARIES=

# On-demand Jellyfin posters. Nginx caches only viewed posters in a hard-bounded
# 256 MiB ephemeral cache; the local catalogue API validates exact item ID+tag.
POSTER_PROXY_MAX_WIDTH=320
POSTER_PROXY_QUALITY=72

# Catalogue v2: lightweight inventory + local SQLite API.
# Bootstrap stores only browse/search fields and commits each page immediately.
CATALOGUE_BOOTSTRAP_PAGE_SIZE=1000
# Normal syncs request only items saved since the prior watermark.
CATALOGUE_DELTA_PAGE_SIZE=500
SYNC_OVERLAP_SECONDS=300
# Supervisor scheduler cadence. 600 = every 10 minutes.
SYNC_INTERVAL_SECONDS=600
SYNC_SCHEDULER_INITIAL_DELAY=90
# Periodic deletion/move safety inventory uses IDs only.
CATALOGUE_ID_PAGE_SIZE=2000
CATALOGUE_ID_DETAIL_BATCH=200
RECONCILE_INTERVAL_HOURS=24
# Refuse unexpectedly destructive reconciliations rather than mass-delete local state.
RECONCILE_MAX_DELETE_FRACTION=0.35
# Rich metadata is fetched for one opened item and cached for seven days.
DETAIL_CACHE_TTL_SECONDS=604800
# TV season lists and selected-season episode tables are lazy and cached for 6 hours.
EPISODE_CACHE_TTL_SECONDS=21600
REQUEST_TIMEOUT=60

# Optional Plex/Emby — leave empty when unused. Their inherited static catalogue
# path remains supported and still uses the legacy cron setting below.
PLEX_URL=
PLEX_TOKEN=
PLEX_EXCLUDE_LIBRARIES=
EMBY_URL=
EMBY_TOKEN=
EMBY_USER_ID=
EMBY_EXCLUDE_LIBRARIES=
PAGE_SIZE=500
BACKDROP_MAX_WIDTH=1280
IMAGE_QUALITY=82
DOWNLOAD_BACKDROPS=false
CRON_SCHEDULE="0 */6 * * *"

# General
TZ=Europe/London
APP_TITLE=Beyond Glimpse
SORT_BY_DATE_ADDED=false
